{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "amimono-note-license-test",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "test",
    "LOCAL_DEVELOPMENT": "false",
    "STRIPE_PRICE_ID_TEST": "price_REPLACE_WITH_TEST_PRICE",
    "STRIPE_PRICE_ID_LIVE": "",
    "FRONTEND_URL": "https://asm-asm.github.io/patterncanvas/iphone/"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "amimono-note-license-test",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }]
}
